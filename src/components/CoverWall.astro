---
// Mural de capas ou cartazes em três faixas que correm em sentidos alternados,
// com as bordas sumindo no preto.
import Marquee from "./Marquee.astro"
import { UI, type Lang } from "../i18n"
interface Props {
    rows: { src: string; alt: string }[][]
    href?: string
    label: string
    lang?: Lang
}
const { rows: raw, href, label, lang = "pt" } = Astro.props
const rows = raw.map((r) => r.map((im) => ({ ...im, alt: UI[lang].alt(im.alt) })))
---

<div class="wall" role="region" aria-label={label}>
    {
        rows.map((row, i) => (
            <Marquee speed={60 + i * 12} reverse={i % 2 === 1}>
                {row.map((im) =>
                    href ? (
                        <a class="cv" href={href}>
                            <img src={im.src} alt={im.alt} loading="lazy" decoding="async" width="300" height="300" />
                        </a>
                    ) : (
                        <span class="cv">
                            <img src={im.src} alt={im.alt} loading="lazy" decoding="async" width="300" height="300" />
                        </span>
                    ),
                )}
            </Marquee>
        ))
    }
</div>

<style>
    .wall {
        display: flex;
        flex-direction: column;
        gap: 10px;
        -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 50%, #000 45%, transparent 100%);
        mask-image: radial-gradient(ellipse 60% 70% at 50% 50%, #000 45%, transparent 100%);
    }
    .cv {
        display: block;
        width: 300px;
        aspect-ratio: 1;
        margin-right: 10px;
        overflow: hidden;
        background: var(--bg-2);
    }
    .cv img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s var(--ease);
    }
    a.cv:hover img,
    a.cv:focus-visible img {
        transform: scale(1.05);
    }
    @media (max-width: 809px) {
        .cv {
            width: 200px;
        }
        .wall {
            -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, #000 50%, transparent 100%);
            mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, #000 50%, transparent 100%);
        }
    }
</style>
