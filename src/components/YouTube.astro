---
// Vídeo do YouTube que só carrega o player ao clicar (página mais leve). Mostra a
// miniatura do vídeo com botão de play.
interface Props {
    id: string
    title: string
}
const { id, title } = Astro.props
---

<div class="yt" data-id={id} data-title={title}>
    <button type="button" aria-label={`Assistir: ${title}`}>
        <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
        <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24" width="28" height="28"><path d="M8 5v14l11-7z" fill="currentColor"></path></svg></span>
    </button>
</div>

<script>
    document.querySelectorAll<HTMLElement>(".yt").forEach((el) => {
        el.querySelector("button")?.addEventListener("click", () => {
            const f = document.createElement("iframe")
            f.src = `https://www.youtube-nocookie.com/embed/${el.dataset.id}?autoplay=1&rel=0&modestbranding=1&playsinline=1`
            f.title = el.dataset.title || "Vídeo"
            f.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen"
            f.allowFullscreen = true
            el.replaceChildren(f)
        })
    })
</script>

<style>
    .yt {
        position: relative;
        aspect-ratio: 16 / 9;
        background: var(--bg-2);
        overflow: hidden;
    }
    .yt button {
        all: unset;
        cursor: pointer;
        position: absolute;
        inset: 0;
    }
    .yt button:focus-visible {
        outline: 2px solid var(--fg);
        outline-offset: 3px;
    }
    .yt img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s var(--ease), filter 0.6s var(--ease);
        filter: brightness(0.8);
    }
    .yt button:hover img {
        transform: scale(1.04);
        filter: brightness(1);
    }
    .play {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 64px;
        height: 44px;
        border-radius: 12px;
        background: rgba(0, 0, 0, 0.7);
        display: grid;
        place-items: center;
        color: #fff;
    }
    .yt :global(iframe) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
    }
</style>
