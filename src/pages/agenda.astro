---
import Base from "../layouts/Base.astro"
import SecHead from "../components/SecHead.astro"
import AgendaList from "../components/AgendaList.astro"
---

<Base title="Agenda" description="Agenda de apresentações da Aninha: próximas datas e datas anteriores.">
    <section class="ag">
        <SecHead tag="h1" label="/ Agenda" title="Próximas datas" width={760} />
        <div class="wrap list">
            <AgendaList />
            <p class="s book">Para bookings: <a class="flip link-text" href="/contato"><span>Contato</span><span aria-hidden="true">Contato</span></a></p>
        </div>
    </section>
</Base>

<style>
    .ag {
        padding-top: 80px;
    }
    .list {
        max-width: 1080px;
        margin: 80px auto 0;
    }
    .book {
        display: flex;
        gap: 12px;
        align-items: center;
        margin-top: 40px;
    }
    @media (max-width: 809px) {
        .ag {
            padding-top: 30px;
        }
        .list {
            margin-top: 40px;
        }
    }
</style>
