---
import Base from "../layouts/Base.astro"
import SecHead from "../components/SecHead.astro"

// Álbuns no Spotify, na ordem do site antigo. O primeiro aparece em destaque.
const albums = ["2967C7EpDqo5UmlUPAygpA", "2tOXBfOg3KGnwsQrn2ll6w", "4RNVyqm5uXPKci5D4oJlaS", "0ZOA6vY4HXB2G6mqG0Gte4", "7qawcrhP8PEOHhCAc2at83", "6MGUUC3UyYpYVfjstTE1OO", "14evB3117hHYREk5QDgQnr", "3HbVWcFDcD9KibfFefmRsU", "2e62hNJoyvhOErnkGnifnz", "6Soh1xjZKuWRL6zccD01IC", "4lXrmoWMAuib1luOyOxE3Y", "6yLgLnSvTYuGLjg9wv0d2b", "5Ngv1u6apoXqQczPPkhB18", "1SYS4fmEr9Syd6HFYlCMMQ", "6QjgrxBC53isRHeFHxlvcl", "1wLJpJrOkTE0pSavK0eEH0", "4lwDjSAsFGG8zj4KJ7lEkS", "11vKDUeDimhkJkPYhkJEew", "0ThoD4yOOrCcv9OnA0JlTV", "3JC8VioPIbCVlCXiUJyNiA", "0EEuTdkvzVNiF8MswW1S2k", "3r0c92c4zuVsM9aNCEjdCR", "7APuy4y0sbhrWIpDAdefkG", "117Dup2m9PORocrEVKe4GH", "4HXJ4cjYZ0JzGyyF1bJsal", "1MOkM5sEy5gBiUKHR5WTit", "0YBCUIfI3VMEI6QTj4XJuS", "3RObSxOqBmwkSMEz1Jog6h"]
// Mostra o destaque + 4; o resto abre no "Mostrar tudo"
const [first, ...others] = albums
const visible = others.slice(0, 4)
const more = others.slice(4)
const src = (id: string) => `https://open.spotify.com/embed/album/${id}?theme=0`
---

<Base title="Discografia" description="Confira os lançamentos da Aninha: álbuns, EPs e remixes.">
    <section class="disco">
        <SecHead tag="h1" width={760} label="/ Discografia" title="Confira os últimos lançamentos" />
        <div class="wrap">
            <iframe class="sp sp-main" src={src(first)} title="Lançamento em destaque no Spotify" width="100%" height="352" loading="lazy" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"></iframe>
            <div class="grid">
                {visible.map((id, i) => <iframe class="sp" src={src(id)} title={`Lançamento ${i + 2} no Spotify`} width="100%" height="352" loading="lazy" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" />)}
            </div>
            <div class="grid" id="mais" hidden>
                {more.map((id, i) => <iframe class="sp" data-src={src(id)} title={`Lançamento ${i + 6} no Spotify`} width="100%" height="352" loading="lazy" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" />)}
            </div>
            <button type="button" class="toggle link-text" aria-expanded="false" aria-controls="mais">
                <span class="t-label">Mostrar tudo ({albums.length})</span>
                <svg class="t-arrow" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14m6-6-6 6m-6-6 6 6"></path></svg>
            </button>
            <p class="s more"><a class="flip link-text" href="https://www.beatport.com/artist/aninha/106303" target="_blank" rel="noopener noreferrer"><span>Discografia completa no Beatport ↗</span><span aria-hidden="true">Discografia completa no Beatport ↗</span></a></p>
        </div>
    </section>
</Base>

<script>
    const btn = document.querySelector<HTMLButtonElement>(".toggle")
    const box = document.getElementById("mais")
    const label = btn?.querySelector(".t-label")
    const total = label?.textContent || ""
    btn?.addEventListener("click", () => {
        if (!box || !label) return
        const open = btn.getAttribute("aria-expanded") !== "true"
        btn.setAttribute("aria-expanded", String(open))
        box.hidden = !open
        label.textContent = open ? "Mostrar menos" : total
        // só carrega os players quando abre, para a página não ficar pesada
        if (open) box.querySelectorAll<HTMLIFrameElement>("iframe[data-src]").forEach((f) => {
            f.src = f.dataset.src!
            f.removeAttribute("data-src")
        })
        else btn.scrollIntoView({ block: "center", behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" })
    })
</script>

<style>
    .disco {
        padding-top: 80px;
    }
    .sp {
        border: 0;
        border-radius: 12px;
        background: var(--bg-2);
    }
    .sp-main {
        max-width: 740px;
        margin: 80px auto 0;
    }
    .grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 30px;
        max-width: 740px;
        margin: 30px auto 0;
    }
    .grid[hidden] {
        display: none;
    }
    .toggle {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 44px;
        margin: 40px auto 0;
        padding: 0 4px;
        background: none;
        border: 0;
        color: var(--fg);
        font-family: inherit;
        text-transform: uppercase;
        cursor: pointer;
    }
    .t-arrow {
        transition: transform 0.4s var(--ease);
    }
    .toggle[aria-expanded="true"] .t-arrow {
        transform: rotate(180deg);
    }
    .toggle:hover .t-label {
        text-decoration: underline;
        text-underline-offset: 4px;
    }
    .more {
        display: flex;
        justify-content: center;
        margin-top: 60px;
        color: var(--fg);
    }
    @media (max-width: 809px) {
        .disco {
            padding-top: 30px;
        }
        .sp-main {
            margin-top: 40px;
        }
        .grid {
            grid-template-columns: 1fr;
            gap: 20px;
        }
    }
</style>
