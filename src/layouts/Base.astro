---
import "../styles/global.css"
import Flip from "../components/Flip.astro"
import { NAV, SOCIAL } from "../data/site"
import { UI, LANGS, HTML_LANG, href as to, switchTo, type Lang } from "../i18n"

interface Props {
    title?: string
    description: string
    home?: boolean
    image?: string
    lang?: Lang
}
const { title, description, home = false, image = "/img/og.jpg", lang = "pt" } = Astro.props
const t = UI[lang]
const fullTitle = title ? `${title} · Aninha` : t.siteTitle
const path = Astro.url.pathname.replace(/\/$/, "") || "/"
const canonical = new URL(path, Astro.site)
const nav = NAV.map((n, i) => ({ href: to(lang, n.href), label: t.nav[i] }))
const homeHref = to(lang, "/")
const norm = (h: string) => h.replace(/\/$/, "") || "/"
const isCurrent = (h: string) => (norm(h) === norm(homeHref) ? path === norm(h) : path.startsWith(norm(h)))
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={new URL(image, Astro.site)} />
        <meta name="theme-color" content="#000000" />
        {LANGS.map((l) => <link rel="alternate" hreflang={HTML_LANG[l]} href={new URL(switchTo(path, l), Astro.site)} />)}
        <link rel="alternate" hreflang="x-default" href={new URL(switchTo(path, "pt"), Astro.site)} />
        <link rel="icon" href="/favicon.png" type="image/png" />
        <script is:inline>document.documentElement.classList.add("js")</script>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,600&display=swap" rel="stylesheet" />
    </head>
    <body>
        <a class="skip" href="#conteudo">{t.skip}</a>

        <header class:list={["top", { "top-home": home }]}>
            <div class="top-bar">
                <a class="top-logo" href={homeHref} aria-label={t.home}>
                    <img src="/img/logo.png" alt="" width="1022" height="160" />
                </a>
                <nav class="top-nav" aria-label={t.navMain}>
                    {nav.map((n) => <Flip href={n.href} label={n.label} current={isCurrent(n.href)} />)}
                </nav>
                <div class="langs" role="group" aria-label={t.langs}>
                    {
                        LANGS.map((l) => (
                            <a href={switchTo(path, l)} hreflang={HTML_LANG[l]} lang={HTML_LANG[l]} aria-current={l === lang ? "true" : undefined}>
                                {l}
                            </a>
                        ))
                    }
                </div>
                <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu">
                    <span class="sr-only" data-open={t.openMenu} data-close={t.closeMenu}>{t.openMenu}</span>
                    <span class="bars" aria-hidden="true"><i></i><i></i></span>
                </button>
            </div>
        </header>
        {
            home && (
                <a class="home-logo" href={homeHref} aria-label={t.home}>
                    <img src="/img/logo.png" alt="" width="1022" height="160" />
                </a>
            )
        }

        <div class="menu" id="menu" hidden>
            <nav aria-label="Menu">
                {
                    nav.map((n) => (
                        <a class="h1" href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>
                            {n.label}
                        </a>
                    ))
                }
            </nav>
            <div class="menu-social">
                {
                    SOCIAL.map((s) => (
                        <a class="link-text" href={s.href} target="_blank" rel="noopener noreferrer">
                            {s.label}
                        </a>
                    ))
                }
            </div>
        </div>

        <main id="conteudo">
            <slot />
        </main>

        <footer class="foot">
            <img class="foot-img" src="/img/footer.jpg" alt={t.footerAlt} loading="lazy" width="1600" height="1067" />
            <div class="foot-in wrap">
                <nav class="foot-nav" aria-label={t.footer}>
                    {nav.map((n) => <Flip href={n.href} label={n.label} />)}
                </nav>
                <hr />
                <div class="foot-nav">
                    {SOCIAL.map((s) => <Flip href={s.href} label={s.label} external />)}
                </div>
                <img class="foot-logo" src="/img/logo.png" alt="Aninha" loading="lazy" width="1022" height="160" />
            </div>
        </footer>

        <script>
            // texto sai do desfoque quando entra na tela
            const items = document.querySelectorAll(".blur")
            if (!("IntersectionObserver" in window)) items.forEach((el) => el.classList.add("in"))
            else {
                const io = new IntersectionObserver(
                    (entries) => {
                        for (const e of entries)
                            if (e.isIntersecting) {
                                e.target.classList.add("in")
                                io.unobserve(e.target)
                            }
                    },
                    { rootMargin: "0px 0px -10% 0px" },
                )
                items.forEach((el) => io.observe(el))
                // segurança: se o navegador não chegar a avisar (aba em segundo plano,
                // leitores e robôs), mostra tudo para nenhum texto ficar escondido
                setTimeout(() => {
                    if (!document.querySelector(".blur.in")) items.forEach((el) => el.classList.add("in"))
                }, 2500)
            }

            // menu fixo: fundo ao rolar e, na home, logo pequeno depois do logo grande
            const top = document.querySelector<HTMLElement>(".top")
            const bigLogo = document.querySelector<HTMLElement>(".home-logo")
            const onScroll = () => {
                top?.classList.toggle("scrolled", scrollY > 8)
                if (bigLogo) top?.classList.toggle("show-logo", bigLogo.getBoundingClientRect().bottom < 60)
            }
            addEventListener("scroll", onScroll, { passive: true })
            onScroll()

            // menu do celular
            const btn = document.querySelector<HTMLButtonElement>(".menu-btn")
            const menu = document.getElementById("menu")
            const setOpen = (open: boolean) => {
                if (!btn || !menu) return
                btn.setAttribute("aria-expanded", String(open))
                const sr = btn.querySelector<HTMLElement>(".sr-only")!
                sr.textContent = (open ? sr.dataset.close : sr.dataset.open) || ""
                menu.hidden = !open
                document.body.style.overflow = open ? "hidden" : ""
                if (open) menu.querySelector<HTMLElement>("a")?.focus()
            }
            btn?.addEventListener("click", () => setOpen(btn.getAttribute("aria-expanded") !== "true"))
            document.addEventListener("keydown", (e) => {
                if (e.key === "Escape" && btn?.getAttribute("aria-expanded") === "true") {
                    setOpen(false)
                    btn.focus()
                }
            })
        </script>
    </body>
</html>

<style>
    /* menu fixo no topo; ganha fundo e fica mais baixo ao rolar */
    .top {
        position: sticky;
        top: 0;
        z-index: 40;
        transition: background-color 0.4s var(--ease);
    }
    .top.scrolled {
        background: rgba(0, 0, 0, 0.82);
        -webkit-backdrop-filter: blur(12px);
        backdrop-filter: blur(12px);
    }
    .top-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 26px var(--gutter);
        transition: padding 0.4s var(--ease);
    }
    .top.scrolled .top-bar {
        padding-block: 16px;
    }
    /* na home o logo pequeno só aparece depois que o logo grande sai da tela */
    .top-home .top-logo {
        display: none;
    }
    .top-home.show-logo .top-logo {
        display: block;
    }
    .top-home.show-logo .top-nav {
        flex: none;
    }
    .top-home.show-logo .top-bar {
        justify-content: space-between;
    }
    .top-home .top-bar {
        position: relative;
    }
    .top-nav {
        display: flex;
        gap: 30px;
    }
    .top-home .top-nav {
        flex: 1;
        justify-content: space-between;
    }
    .langs {
        display: flex;
        gap: 4px;
        margin-left: 30px;
    }
    .langs a {
        font-size: 12px;
        font-weight: 600;
        min-width: 28px;
        min-height: 28px;
        display: inline-grid;
        place-items: center;
        color: var(--muted);
        transition: color 0.3s;
    }
    .langs a:hover,
    .langs a[aria-current="true"] {
        color: var(--fg);
    }
    .top-logo img {
        width: 80px;
        height: auto;
    }
    .home-logo {
        display: block;
        width: min(1000px, 100% - 2 * var(--gutter));
        margin: 40px auto 0;
    }
    .home-logo img {
        width: 100%;
        height: auto;
    }
    .menu-btn {
        display: none;
        width: 44px;
        height: 44px;
        background: none;
        border: 0;
        color: var(--fg);
        cursor: pointer;
        position: relative;
        z-index: 40;
    }
    .bars {
        position: relative;
        display: block;
        width: 26px;
        height: 10px;
        margin: 0 auto;
    }
    .bars i {
        position: absolute;
        left: 0;
        right: 0;
        height: 1.5px;
        background: currentColor;
        transition: transform 0.35s var(--ease), top 0.35s var(--ease);
    }
    .bars i:first-child {
        top: 0;
    }
    .bars i:last-child {
        top: 8.5px;
    }
    .menu-btn[aria-expanded="true"] .bars i:first-child {
        top: 4px;
        transform: rotate(45deg);
    }
    .menu-btn[aria-expanded="true"] .bars i:last-child {
        top: 4px;
        transform: rotate(-45deg);
    }
    .menu {
        position: fixed;
        inset: 0;
        z-index: 30;
        background: var(--bg);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 110px var(--gutter) 40px;
    }
    .menu[hidden] {
        display: none;
    }
    .menu nav {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }
    .menu nav a[aria-current="page"] {
        color: var(--muted);
    }
    .menu-social {
        display: flex;
        flex-direction: column;
        gap: 16px;
        border-top: 1px solid var(--line);
        padding-top: 24px;
    }
    .menu-social a {
        min-height: 24px;
    }

    .foot {
        position: relative;
        margin-top: 200px;
        overflow: hidden;
        min-height: 900px;
        display: flex;
        align-items: flex-end;
    }
    .foot-img {
        position: absolute;
        right: 0;
        top: 0;
        width: min(100%, 1440px);
        height: 100%;
        object-fit: cover;
        object-position: 70% 20%;
        -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 35%);
        mask-image: linear-gradient(to right, transparent 0%, #000 35%);
    }
    .foot::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, #000 22%, rgba(0, 0, 0, 0.55) 45%, transparent 70%);
        pointer-events: none;
    }
    .foot-in {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 16px;
        padding-bottom: 40px;
    }
    .foot-nav {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 12px 30px;
    }
    .foot hr {
        width: 100%;
        border: 0;
        border-top: 1px solid rgba(255, 255, 255, 0.35);
        margin: 4px 0;
    }
    .foot-logo {
        width: min(1000px, 100%);
        height: auto;
        margin: 120px auto 0;
    }

    @media (max-width: 809px) {
        .top-nav {
            display: none;
        }
        .menu-btn {
            display: block;
        }
        .langs {
            margin-left: auto;
        }
        .top-home .top-bar {
            justify-content: flex-end;
            padding-block: 14px;
        }
        .top-bar {
            padding-block: 14px;
        }
        .home-logo {
            margin-top: 0;
            width: calc(100% - 2 * var(--gutter));
        }
        .foot {
            min-height: 720px;
            margin-top: 120px;
        }
        .foot-img {
            width: 100%;
            height: 62%;
            -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent 100%);
            mask-image: linear-gradient(to bottom, #000 60%, transparent 100%);
        }
        .foot-nav {
            flex-direction: column;
            align-items: flex-start;
            gap: 4px;
        }
        .foot-logo {
            margin-top: 40px;
        }
    }
</style>
