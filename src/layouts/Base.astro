---
import "../styles/global.css"
import Flip from "../components/Flip.astro"
import { NAV, SOCIAL } from "../data/site"

interface Props {
    title?: string
    description: string
    home?: boolean
    image?: string
}
const { title, description, home = false, image = "/img/og.jpg" } = Astro.props
const fullTitle = title ? `${title} · Aninha` : "Aninha | DJ & Produtora de Música Eletrônica"
const path = Astro.url.pathname.replace(/\/$/, "") || "/"
const canonical = new URL(path, Astro.site)
const isCurrent = (href: string) => (href === "/" ? path === "/" : path.startsWith(href))
---

<!doctype html>
<html lang="pt-BR">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={new URL(image, Astro.site)} />
        <meta name="theme-color" content="#000000" />
        <link rel="icon" href="/favicon.png" type="image/png" />
        <script is:inline>document.documentElement.classList.add("js")</script>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,600&display=swap" rel="stylesheet" />
    </head>
    <body>
        <a class="skip" href="#conteudo">Pular para o conteúdo</a>

        <header class:list={["top", { "top-home": home }]}>
            <div class="top-bar">
                {
                    !home && (
                        <a class="top-logo" href="/" aria-label="Aninha, página inicial">
                            <img src="/img/logo.png" alt="" width="1022" height="160" />
                        </a>
                    )
                }
                <nav class="top-nav" aria-label="Principal">
                    {NAV.map((n) => <Flip href={n.href} label={n.label} current={isCurrent(n.href)} />)}
                </nav>
                <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu">
                    <span class="sr-only">Abrir menu</span>
                    <span class="bars" aria-hidden="true"><i></i><i></i></span>
                </button>
            </div>
            {
                home && (
                    <a class="home-logo" href="/" aria-label="Aninha, página inicial">
                        <img src="/img/logo.png" alt="" width="1022" height="160" />
                    </a>
                )
            }
        </header>

        <div class="menu" id="menu" hidden>
            <nav aria-label="Menu">
                {
                    NAV.map((n) => (
                        <a class="h1" href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>
                            {n.label}
                        </a>
                    ))
                }
            </nav>
            <div class="menu-social">
                {
                    SOCIAL.map((s) => (
                        <a class="link-text" href={s.href} target="_blank" rel="noopener noreferrer">
                            {s.label}
                        </a>
                    ))
                }
            </div>
        </div>

        <main id="conteudo">
            <slot />
        </main>

        <footer class="foot">
            <img class="foot-img" src="/img/footer.jpg" alt="Retrato em preto e branco da Aninha" loading="lazy" width="1600" height="1067" />
            <div class="foot-in wrap">
                <nav class="foot-nav" aria-label="Rodapé">
                    {NAV.map((n) => <Flip href={n.href} label={n.label} />)}
                </nav>
                <hr />
                <div class="foot-nav">
                    {SOCIAL.map((s) => <Flip href={s.href} label={s.label} external />)}
                </div>
                <img class="foot-logo" src="/img/logo.png" alt="Aninha" loading="lazy" width="1022" height="160" />
            </div>
        </footer>

        <script>
            // texto sai do desfoque quando entra na tela
            const items = document.querySelectorAll(".blur")
            if (!("IntersectionObserver" in window)) items.forEach((el) => el.classList.add("in"))
            else {
                const io = new IntersectionObserver(
                    (entries) => {
                        for (const e of entries)
                            if (e.isIntersecting) {
                                e.target.classList.add("in")
                                io.unobserve(e.target)
                            }
                    },
                    { rootMargin: "0px 0px -10% 0px" },
                )
                items.forEach((el) => io.observe(el))
                // segurança: se o navegador não chegar a avisar (aba em segundo plano,
                // leitores e robôs), mostra tudo para nenhum texto ficar escondido
                setTimeout(() => {
                    if (!document.querySelector(".blur.in")) items.forEach((el) => el.classList.add("in"))
                }, 2500)
            }

            // menu do celular
            const btn = document.querySelector<HTMLButtonElement>(".menu-btn")
            const menu = document.getElementById("menu")
            const setOpen = (open: boolean) => {
                if (!btn || !menu) return
                btn.setAttribute("aria-expanded", String(open))
                btn.querySelector(".sr-only")!.textContent = open ? "Fechar menu" : "Abrir menu"
                menu.hidden = !open
                document.body.style.overflow = open ? "hidden" : ""
                if (open) menu.querySelector<HTMLElement>("a")?.focus()
            }
            btn?.addEventListener("click", () => setOpen(btn.getAttribute("aria-expanded") !== "true"))
            document.addEventListener("keydown", (e) => {
                if (e.key === "Escape" && btn?.getAttribute("aria-expanded") === "true") {
                    setOpen(false)
                    btn.focus()
                }
            })
        </script>
    </body>
</html>

<style>
    .top {
        position: relative;
        z-index: 20;
    }
    .top-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 26px var(--gutter);
    }
    .top-home .top-bar {
        position: relative;
    }
    .top-nav {
        display: flex;
        gap: 30px;
    }
    .top-home .top-nav {
        flex: 1;
        justify-content: space-between;
    }
    .top-logo img {
        width: 80px;
        height: auto;
    }
    .home-logo {
        display: block;
        width: min(1000px, 100% - 2 * var(--gutter));
        margin: 40px auto 0;
    }
    .home-logo img {
        width: 100%;
        height: auto;
    }
    .menu-btn {
        display: none;
        width: 44px;
        height: 44px;
        background: none;
        border: 0;
        color: var(--fg);
        cursor: pointer;
        position: relative;
        z-index: 40;
    }
    .bars {
        position: relative;
        display: block;
        width: 26px;
        height: 10px;
        margin: 0 auto;
    }
    .bars i {
        position: absolute;
        left: 0;
        right: 0;
        height: 1.5px;
        background: currentColor;
        transition: transform 0.35s var(--ease), top 0.35s var(--ease);
    }
    .bars i:first-child {
        top: 0;
    }
    .bars i:last-child {
        top: 8.5px;
    }
    .menu-btn[aria-expanded="true"] .bars i:first-child {
        top: 4px;
        transform: rotate(45deg);
    }
    .menu-btn[aria-expanded="true"] .bars i:last-child {
        top: 4px;
        transform: rotate(-45deg);
    }
    .menu {
        position: fixed;
        inset: 0;
        z-index: 30;
        background: var(--bg);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 110px var(--gutter) 40px;
    }
    .menu[hidden] {
        display: none;
    }
    .menu nav {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }
    .menu nav a[aria-current="page"] {
        color: var(--muted);
    }
    .menu-social {
        display: flex;
        flex-direction: column;
        gap: 16px;
        border-top: 1px solid var(--line);
        padding-top: 24px;
    }
    .menu-social a {
        min-height: 24px;
    }

    .foot {
        position: relative;
        margin-top: 200px;
        overflow: hidden;
        min-height: 900px;
        display: flex;
        align-items: flex-end;
    }
    .foot-img {
        position: absolute;
        right: 0;
        top: 0;
        width: min(100%, 1440px);
        height: 100%;
        object-fit: cover;
        object-position: 70% 20%;
        -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 35%);
        mask-image: linear-gradient(to right, transparent 0%, #000 35%);
    }
    .foot::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, #000 22%, rgba(0, 0, 0, 0.55) 45%, transparent 70%);
        pointer-events: none;
    }
    .foot-in {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 16px;
        padding-bottom: 40px;
    }
    .foot-nav {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 12px 30px;
    }
    .foot hr {
        width: 100%;
        border: 0;
        border-top: 1px solid rgba(255, 255, 255, 0.35);
        margin: 4px 0;
    }
    .foot-logo {
        width: min(1000px, 100%);
        height: auto;
        margin: 120px auto 0;
    }

    @media (max-width: 809px) {
        .top-nav {
            display: none;
        }
        .menu-btn {
            display: block;
        }
        .top-home .top-bar {
            justify-content: flex-end;
            padding-block: 14px;
        }
        .top-bar {
            padding-block: 14px;
        }
        .home-logo {
            margin-top: 0;
            width: calc(100% - 2 * var(--gutter));
        }
        .foot {
            min-height: 720px;
            margin-top: 120px;
        }
        .foot-img {
            width: 100%;
            height: 62%;
            -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent 100%);
            mask-image: linear-gradient(to bottom, #000 60%, transparent 100%);
        }
        .foot-nav {
            flex-direction: column;
            align-items: flex-start;
            gap: 4px;
        }
        .foot-logo {
            margin-top: 40px;
        }
    }
</style>
